# Αντέγραψε σε .env — ΠΟΤΕ μην κάνεις commit το .env

# --- Κοινά ---
ERP_BASE_URL=http://localhost:8080
APP_API_URL=http://localhost:8000
VOICE_URL=http://localhost:8100
PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_API_URL=http://localhost:8000   # το dashboard (browser) μιλάει εδώ
NEXT_PUBLIC_VOICE_URL=http://localhost:8100     # κουμπί «Κάλεσε» στη σελίδα /voice
DEMO_MODE=true

# --- LLM (εξηγήσεις dashboard + voice agent) ---
ANTHROPIC_API_KEY=

# --- Voice (Νίκος) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
VOICE_PUBLIC_URL=https://<ngrok-host>          # για Twilio webhooks
VOICE_ALLOWED_NUMBERS=+3069XXXXXXXX            # comma-separated allowlist
VOICE_QUIET_HOURS=20:00-09:00
# Τηλέφωνο demo ανά πωλητή (PRSN). Μόνο allowlisted αριθμοί.
SALESMAN_105_PHONE=
SALESMAN_101_PHONE=
