# Αντέγραψε σε .env — ΠΟΤΕ μην κάνεις commit το .env

# --- Κοινά ---
ERP_BASE_URL=http://localhost:8080
# VORA agent: ώρα ημερήσιας εκτέλεσης από το App API (κενό = κλειστό)
AGENT_DAILY_AT=06:00
APP_API_URL=http://localhost:8000
VOICE_URL=http://localhost:8100
PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_API_URL=http://localhost:8000   # το dashboard (browser) μιλάει εδώ
NEXT_PUBLIC_VOICE_URL=http://localhost:8100     # κουμπί «Κάλεσε» στη σελίδα /voice
NEXT_PUBLIC_VOICE_TOKEN=""                      # μόνο αν ο voice agent έχει VOICE_TRIGGER_TOKEN
DEMO_MODE=true

# --- LLM (εξηγήσεις dashboard + voice agent) ---
ANTHROPIC_API_KEY=
# Market Scan (apps/api/app/market.py): κάθε πόσες μέρες τρέχει η έρευνα αγοράς (0 = μόνο με το κουμπί)
MARKET_SCAN_EVERY_DAYS=7
# SMS προσφορών (apps/api/app/outreach.py) μέσω Apifon — token/secret από το Mookee (mookee.apifon.com)
APIFON_TOKEN=
APIFON_SECRET=
APIFON_SENDER=VORA          # ως 11 λατινικοί χαρακτήρες, εγκεκριμένο από το Apifon
# Demo: ΟΛΑ τα SMS πάνε σε αυτό το κινητό (τα δεδομένα δεν έχουν κινητά πελατών). Κενό → CUSTOMER_<TRDR>_PHONE
SMS_DEMO_TO=

# --- Voice ---
# Ο voice agent (apps/voice) τρέχει στο VPS με δικές του ρυθμίσεις: apps/voice/deploy/voicerestock.env.example
# (τηλέφωνα πωλητών, allowlist, ώρες ησυχίας). Εδώ τίποτα — το dashboard τον βρίσκει στο NEXT_PUBLIC_VOICE_URL.
SALESMAN_105_PHONE=""   # προαιρετικό: μόνο για να φαίνεται στο /api/salesmen
