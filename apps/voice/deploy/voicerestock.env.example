# Αντέγραψε στο VPS ως /root/voicerestock/voicerestock.env — ΠΟΤΕ στο git.
# Τα κλειδιά LiveKit/OpenAI/Google έρχονται από το /root/greek-voice-agent/.env (δεν αλλάζει).

# App API: τρέχει στο laptop και φτάνει στο VPS μέσω του reverse tunnel (apps/voice/deploy/tunnel.sh)
APP_API_URL=http://127.0.0.1:18000

# HTTP για το κουμπί «Κάλεσε» του dashboard (μόνο localhost· από το laptop μέσω του tunnel)
VOICE_HTTP_PORT=8100
VOICE_TRIGGER_TOKEN=

# Τηλέφωνο ανά πωλητή (PRSN), μορφή +3069XXXXXXXX. Καλούνται ΜΟΝΟ αριθμοί που είναι και στο allowlist.
SALESMAN_105_PHONE=
VOICE_ALLOWED_NUMBERS=

# Ώρες χωρίς κλήσεις, π.χ. 21:00-09:00 (κενό = καμία, για δοκιμές)
VOICE_QUIET_HOURS=

# Μόνο για διάγνωση: γράφει τι ειπώθηκε στα logs
LOG_TRANSCRIPTS=0
